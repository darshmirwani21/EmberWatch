{
  "name": "emberwatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "start": "node dist/server/index.mjs",
    "test:nemotron": "tsx scripts/nemotron-smoke.ts",
    "test:firelines-live": "tsx scripts/fireline-smoke.ts",
    "test:business-live": "tsx scripts/business-smoke.ts",
    "test:intervention-live": "tsx scripts/intervention-smoke.ts",
    "test:history-live": "tsx scripts/history-smoke.ts",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@turf/turf": "^7.3.0",
    "dotenv": "^17.3.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.3.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0"
  }
}
